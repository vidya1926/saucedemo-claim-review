{
  "name": "saucedemo-claim-review",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone SauceDemo UI-test claim review prototype and visualizer",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/unit/*.test.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test tests/e2e-scenario.spec.ts --project=chromium --workers=1",
    "test:demo": "playwright test --project=chromium --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
